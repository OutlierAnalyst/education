# Скопируй этот файл в .env.local и заполни реальными значениями.
# .env.local НЕ должен попадать в git (он уже в .gitignore).

# Токен доступа сообщества/пользователя ВКонтакте с правом messages.
# Получается через VK ID / Standalone-приложение (Implicit Flow) со scope=messages,
# либо через API сообщества (Community Token) с правом "Сообщения сообщества".
VK_ACCESS_TOKEN=

# ID получателя сообщения (peer_id).
# Для личных сообщений — это твой numeric user id (можно узнать, например, через vk.com/id или API users.get).
# Для сообщений в сообщество через Community Token — обычно тоже используется id пользователя-получателя.
VK_PEER_ID=

# Версия VK API (необязательно, по умолчанию используется 5.199)
VK_API_VERSION=5.199
